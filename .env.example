# AXIS News Intelligence — Environment Variables Template
# Copy this file to .env.local for local development, or add variables to your Vercel Project Settings.

# GNews API Key (Optional / Recommended for real-time live dispatches)
# Get a free key at: https://gnews.io
VITE_GNEWS_API_KEY="your_gnews_api_key_here"

# NewsData.io API Key (Optional fallback)
# Get a free key at: https://newsdata.io
VITE_NEWSDATA_API_KEY="your_newsdata_api_key_here"

# Twitter / X Bearer Token (Optional for social alerts)
VITE_X_BEARER_TOKEN="your_x_bearer_token_here"

# ==============================================================================
# Supabase Backend Configuration (Auth, Cloud Bookmarks & Real-Time Sync)
# ==============================================================================
# 1. Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. Public 'anon' Key (safe for browser frontend client usage)
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# ⚠️ IMPORTANT SECURITY NOTE REGARDING YOUR SUPABASE DATABASE PASSWORD:
# - NEVER put your master PostgreSQL database password in frontend client code!
# - Keep your database password saved in your password manager (1Password, Apple Keychain, Bitwarden)
#   or in a secure, gitignored local file (e.g. .env.local).
# - The frontend only needs VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
