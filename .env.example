# AXIS News Intelligence — Environment Variables Template
# Copy this file to .env.local for local development, or add variables to your Vercel Project Settings.

# GNews API Key (Optional / Recommended for real-time live dispatches)
# Get a free key at: https://gnews.io
VITE_GNEWS_API_KEY="your_gnews_api_key_here"

# NewsData.io API Key (Optional fallback)
# Get a free key at: https://newsdata.io
VITE_NEWSDATA_API_KEY="your_newsdata_api_key_here"

# Twitter / X Bearer Token (Optional for social alerts)
VITE_X_BEARER_TOKEN="your_x_bearer_token_here"
